/* osm-gpui "Wireframe" MapCSS stylesheet, after JOSM's wireframe view.

   Every way is a thin 1px line in one contrasting colour and nothing is
   filled, so the imagery shows through and only the geometry is drawn.
   Nodes are small simple markers. There are no area (`fill-color`) rules,
   no casings and no labels. Selection and hover highlighting is drawn by the
   renderer on top, in its own colours. */

way     { color: #00e0ff; width: 1; }

/* Nodes. Untagged nodes are way vertices: tiny. Tagged nodes get a slightly
   larger marker in a second colour so points of interest stand out from the
   lines. */
node    { color: #ffd60a; symbol-size: 4; }
node[highway], node[barrier], node[railway], node[power], node[entrance],
node[natural], node[leisure], node[tourism], node[historic], node[man_made],
node[place], node[office], node[craft], node[emergency], node[public_transport],
node[amenity], node[shop]
        { color: #ff9f0a; symbol-size: 6; }
