/* osm-gpui default MapCSS stylesheet.

   Editing data is drawn as thin lines so the imagery being traced stays
   visible; the renderer adds a dark casing under every way for contrast.
   Later rules override earlier ones, so each group goes from general to
   specific. */

way                  { color: #d0d0d0; width: 1.5; }

/* Roads, by importance. */
way[highway]                 { color: #ffffff; width: 2; }
way|z16-[highway]            { width: 3; }
way|z18-[highway]            { width: 5; }
way[highway=motorway], way[highway=motorway_link],
way[highway=trunk], way[highway=trunk_link]         { color: #ff7a90; width: 3; }
way|z15-[highway=motorway], way|z15-[highway=motorway_link],
way|z15-[highway=trunk], way|z15-[highway=trunk_link]         { width: 4; }
way|z17-[highway=motorway], way|z17-[highway=motorway_link],
way|z17-[highway=trunk], way|z17-[highway=trunk_link]         { width: 6; }
way|z14-[highway=motorway], way|z14-[highway=motorway_link],
way|z14-[highway=trunk], way|z14-[highway=trunk_link]         { casing-width: 1; casing-color: #7a2b3b; }
way[highway=primary], way[highway=primary_link]     { color: #ffb347; width: 3; }
way|z15-[highway=primary], way|z15-[highway=primary_link]     { width: 4; }
way|z17-[highway=primary], way|z17-[highway=primary_link]     { width: 6; }
way|z14-[highway=primary], way|z14-[highway=primary_link]     { casing-width: 1; casing-color: #8a5a1c; }
way[highway=secondary], way[highway=secondary_link] { color: #ffe566; width: 2.5; }
way|z15-[highway=secondary], way|z15-[highway=secondary_link] { width: 3.5; }
way|z17-[highway=secondary], way|z17-[highway=secondary_link] { width: 5; }
way|z14-[highway=secondary], way|z14-[highway=secondary_link] { casing-width: 1; casing-color: #8a7a1c; }
way[highway=tertiary], way[highway=tertiary_link]   { color: #fff7b0; width: 2.5; }
way|z15-[highway=tertiary], way|z15-[highway=tertiary_link]   { width: 3.5; }
way|z17-[highway=tertiary], way|z17-[highway=tertiary_link]   { width: 5; }
way|z14-[highway=tertiary], way|z14-[highway=tertiary_link]   { casing-width: 1; casing-color: #8a8458; }
way[highway=track]           { color: #c8935a; width: 1.5; }
way[highway=footway], way[highway=path], way[highway=pedestrian],
way[highway=steps], way[highway=bridleway]          { color: #ff9a8a; width: 1.5; }
way[highway=cycleway]        { color: #7fb2ff; width: 1.5; }

/* Draw order: more important roads on top where they cross. */
way[highway=tertiary], way[highway=tertiary_link]   { z-index: 1; }
way[highway=secondary], way[highway=secondary_link] { z-index: 2; }
way[highway=primary], way[highway=primary_link]     { z-index: 3; }
way[highway=trunk], way[highway=trunk_link]         { z-index: 4; }
way[highway=motorway], way[highway=motorway_link]   { z-index: 5; }

way[railway]         { color: #b8b8c8; width: 2; }
way[waterway]        { color: #4aa8ff; width: 2; }
way[barrier]         { color: #d07070; width: 1; }
way[power]           { color: #9a9a9a; width: 1; }

/* Areas — closed ways only. The generic landuse rule comes before the more
   specific grass/forest/park rules so the specific ones win. */
way[landuse], way[leisure], way[natural] { color: #9fd46a; width: 1; }
area[landuse]   { fill-color: #9fd46a; fill-opacity: 0.15; }
area[leisure=park], area[landuse=grass], area[landuse=forest], area[natural=wood]
                { fill-color: #3fae4a; fill-opacity: 0.25; }
way[natural=water], way[waterway=riverbank] { color: #4aa8ff; width: 1; }
area[natural=water], area[waterway=riverbank] { fill-color: #4aa8ff; fill-opacity: 0.3; }
way[building]   { color: #e08fc0; width: 1; }
area[building]  { fill-color: #e08fc0; fill-opacity: 0.25; }

/* Nodes. Untagged nodes are way vertices: small, and hidden by the renderer
   when zoomed out. */
node            { color: #ffd60a; symbol-size: 5; }
node[highway], node[barrier], node[railway], node[power], node[entrance]
                { color: #ffd60a; symbol-size: 7; }
node[natural], node[leisure], node[tourism], node[historic], node[man_made],
node[place], node[office], node[craft], node[emergency], node[public_transport]
                { color: #5ac8fa; symbol-size: 8; }
node[amenity]   { color: #ff5fa2; symbol-size: 8; }
node[shop]      { color: #4cd964; symbol-size: 8; }

/* Labels and icons (nodes). `text` names the tag shown; a list such as
   `name, addr:housenumber` shows the first present. White text on a dark halo
   reads over both imagery and a blank background. Names appear from z17,
   places from z16 and house numbers from z18; POI icons from z17 use the
   node's preset icon (Maki/Temaki), `icon-image: maki-cafe` overrides it. */
node|z17-[name]         { text: name; font-size: 12; text-color: #ffffff;
                          text-halo-color: #000000; text-halo-radius: 1.5; }
node|z16-[place]        { text: name; font-size: 14; }
node|z18-[addr:housenumber] { text: name, addr:housenumber; }
node|z17-[amenity], node|z17-[shop], node|z17-[tourism], node|z17-[leisure],
node|z17-[historic], node|z17-[office], node|z17-[craft], node|z17-[emergency],
node|z17-[public_transport]  { icon-image: preset; icon-width: 12; }
