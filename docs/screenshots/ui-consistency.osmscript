# UI consistency regression captures: both panes, then a populated right pane.
#
# Coordinate model: the viewport center is at window (488, 388) — see
# select.osmscript for the derivation.
#
# Fixture layout at zoom 18, centered on (40.7120, -74.0060):
#   node 2001 (40.7120, -74.0060) → click (488, 388)   # tagged POI (center)
#   way  3001 (1001 → 1002)       → click (675, 388)   # diagonal line,
#                                   +187px right of center, same geo offset
#                                   as select.osmscript's way click

window 1200 800
# Load BEFORE setting the viewport: the first loaded dataset triggers
# fit_to_osm_data which would otherwise clobber an earlier `viewport` call.
load_osm docs/screenshots/fixtures/select.osm
viewport 40.7120 -74.0060 18
wait_idle 5s

# Both panes, no selection.
capture docs/screenshots/ui-consistency-01-panes.png

# Click the tagged POI node so Selection/Fields/Tags populate.
click 488,388
wait_idle 2s
capture docs/screenshots/ui-consistency-02-selection.png

# Click the way mid-segment: its selection highlight must not hide the
# vertex node markers.
click 675,388
wait_idle 2s
capture docs/screenshots/ui-consistency-03-way-selection.png

log done
