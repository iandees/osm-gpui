# Side panel second visual pass: one type scale and inset across Fields, Tags,
# Relations and Members; Layers on top, the Selection zone scrolling in the
# middle, History pinned at the bottom.
#
# Same fixture and coordinates as side-panel-clarity.osmscript (window
# 1200x800, default 280px panel): node 8104 at (560, 200), way 8202 at
# (520, 200), way 8301 (heavily tagged) at (340, 400), cafe node 8120 at
# (674, 683). The click on the Relations row selects relation 9101. The way's
# preset Fields push that row off screen, so the script collapses Fields
# (header y=210) and Tags (y=243, once Fields has collapsed) first; the row is
# then at y=306 whatever the preset, and the relation's Members list starts at
# y=332 (47.5 per member). The sections are expanded again before the final
# long-selection capture.

window 1200 800
load_osm docs/screenshots/fixtures/side-panel-clarity.osm
viewport 40.7120 -74.0060 18
wait_idle 5s
capture out/side-panel-polish-01-nothing-selected.png

click 674,683
wait_idle 2s
assert_selected node 8120
capture out/side-panel-polish-02-tagged-node.png

# A long selection: the History strip stays pinned below the scrolling middle.
click 340,400
wait_idle 2s
assert_selected way 8301
capture out/side-panel-polish-03-way-many-tags.png

# Box-select the route: several features at once.
drag 60,150 880,260 button=left
wait_idle 2s
capture out/side-panel-polish-04-box-selection.png

# A route member; its Relations row selects the relation.
click 520,200
wait_idle 2s
assert_selected way 8202
capture out/side-panel-polish-05-member-way.png

click 1000,210
wait_idle 1s
click 1000,243
wait_idle 1s
click 1000,306
wait_idle 2s
assert_selected relation 9101
capture out/side-panel-polish-06-relation-members.png

# Hovering a member row reveals its reorder/remove buttons (a few candidate
# rows).
hover 1000,332
wait_idle 1s
capture out/side-panel-polish-06b-member-hover.png
hover 1000,379
wait_idle 1s
capture out/side-panel-polish-06c-member-hover.png

# Keyboard focus: tab through the panel; a focused member row shows its buttons.
key tab
key tab
key tab
key tab
key tab
key tab
key tab
key tab
wait_idle 1s
capture out/side-panel-polish-06d-tab-focus.png
key tab
key tab
wait_idle 1s
capture out/side-panel-polish-06e-tab-focus.png

# A few edits for the History list: reverse a way twice, then delete a route
# member (which also removes it from the relation).
click 340,400
wait_idle 2s
key r
wait_idle 1s
key r
wait_idle 1s
click 520,200
wait_idle 2s
key delete
wait_idle 2s
# History starts collapsed (its header shows the step count); open it.
panel history expand
wait_idle 1s
capture out/side-panel-polish-07-history.png

# The long selection again, now with History entries: still pinned.
click 340,400
wait_idle 2s
click 1000,243
wait_idle 1s
click 1000,210
wait_idle 1s
assert_selected way 8301
capture out/side-panel-polish-08-long-selection-with-history.png

log done
