# The MapRoulette extension (extensions/maproulette), run from an installed
# copy with its HTTP answered from fixtures:
#
#   OSM_GPUI_EXTENSIONS_DIR=<dir with installed/maproulette/{extension.toml,extension.wasm,locales/}> \
#   cargo run --release -- --script docs/screenshots/maproulette.osmscript \
#     --offline --http-fixtures docs/screenshots/fixtures/maproulette/http-fixtures.json
#
# Add `--language de` to see the extension's own German catalog.
#
# Coordinate model: the viewport center is at window (488, 388) — see
# select.osmscript for the derivation. Task 900001 sits there.

window 1200 800
load_osm docs/screenshots/fixtures/areas.osm
viewport 40.714147 -74.006000 17
# Extensions load (compile) in the background after the first frame.
wait_idle 5s

# View > MapRoulette Tasks: the tasks in view as pins,
# coloured by status.
action RunExtensionCommand {"extension":"maproulette","command":"tasks"}
wait_idle 3s
capture out/maproulette-01-tasks.png

# A click on a pin opens the task: its challenge and instructions in a
# side-panel section of its own.
click 488,388
wait_idle 3s
capture out/maproulette-02-task.png

# Its API key is set in Settings > Extensions > MapRoulette.
action ManageExtensions
wait_idle 2s
capture out/maproulette-03-settings.png
key escape
wait_idle 1s

# Selecting a building (by its outline): its fields and tags come first,
# the extension's panels stay below them.
click 267,322
wait_idle 2s
capture out/maproulette-05-with-selection.png

log done
