# Load a busy-tagged POI and screenshot the Tags panel to verify column
# alignment: fixed-width key column, row dividers, wrapped long text.
#
# Coordinate model: the viewport center is at window (488, 388) — see
# select.osmscript for the derivation.

window 1200 800
load_osm docs/screenshots/fixtures/tags_panel.osm
viewport 40.7120 -74.0060 18
wait_idle 5s

# Click the tagged POI node (at the viewport center) to select it and
# populate the Tags panel.
click 488,388
wait_idle 2s
capture out/tags-panel.png
