# Rotated street-name labels on curved ways (prototype). The curved fixture is
# centred 1.1 km north of the straight one so both can be loaded together.
#   cargo run --release -- --script docs/screenshots/line-labels-curves.osmscript
window 1200 800
load_osm docs/screenshots/fixtures/line-labels-curves.osm
viewport 40.7220 -74.0060 17
wait_idle 5s
capture out/line-labels-curves-z17.png
viewport 40.72290 -74.0060 18
wait_idle 2s
capture out/line-labels-curves-arc-z18.png
viewport 40.72411 -74.0060 18
wait_idle 2s
capture out/line-labels-curves-top-z18.png
viewport 40.72047 -74.00482 18
wait_idle 2s
capture out/line-labels-curves-corner-z18.png
viewport 40.72010 -74.00700 19
wait_idle 2s
capture out/line-labels-curves-ramp-z19.png
viewport 40.72146 -74.00849 19
wait_idle 2s
capture out/line-labels-curves-roundabout-z19.png
