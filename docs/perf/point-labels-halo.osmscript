# Point/area label halo cost by label count: docs/screenshots/fixtures/labels-stress.osm
# (350 named POIs), one view per zoom (fewer labels as it zooms in), every halo
# mode forced in turn with `LabelBench:points=MODE` (`auto` is the shipped rule).
#   OSM_GPUI_FRAME_STATS=1 cargo run --release -- --script docs/perf/point-labels-halo.osmscript | grep FRAMESTATS
# Read labels.paint, labels.placed and labels.text (the count the halo rule uses) per
# `frame_stats` label (zZOOM_MODE).
window 1200 800
load_osm docs/screenshots/fixtures/labels-stress.osm
viewport 40.7128 -74.0060 17
wait_idle 5s
wait 1s
frame_stats startup
viewport 40.7128 -74.0060 17
action LabelBench:on,points=auto
wait 800ms
frame_stats discard
wait 2s
frame_stats z17_auto
action LabelBench:on,points=offsets
wait 800ms
frame_stats discard
wait 2s
frame_stats z17_offsets
action LabelBench:on,points=quad
wait 800ms
frame_stats discard
wait 2s
frame_stats z17_quad
action LabelBench:on,points=shadow
wait 800ms
frame_stats discard
wait 2s
frame_stats z17_shadow
action LabelBench:on,points=off
wait 800ms
frame_stats discard
wait 2s
frame_stats z17_off
viewport 40.7128 -74.0060 17.5
action LabelBench:on,points=auto
wait 800ms
frame_stats discard
wait 2s
frame_stats z17.5_auto
action LabelBench:on,points=offsets
wait 800ms
frame_stats discard
wait 2s
frame_stats z17.5_offsets
action LabelBench:on,points=quad
wait 800ms
frame_stats discard
wait 2s
